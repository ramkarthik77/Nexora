{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nexora-spatial",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "AEM_MODE": "mock",
    "ENABLE_ENTERPRISE_CONNECTORS": "false",
    "AI_PROVIDER": "claude",
    "CLAUDE_MODEL": "claude-sonnet-4-5"
  }
}
